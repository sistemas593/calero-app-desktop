<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="balance_comprobacion"
              pageWidth="595" pageHeight="842"
              columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="12345678-aaaa-bbbb-cccc-999999999999">

    <!-- ====================== ESTILOS ====================== -->
    <style name="estiloDetalle" fontSize="9"/>
    <style name="estiloTitulo" fontSize="12" isBold="true"/>
    <style name="estiloTotal" fontSize="9" isBold="true"/>

    <!-- ====================== PARAMETROS ====================== -->
    <parameter name="empresa" class="java.lang.String"/>
    <parameter name="sucursal" class="java.lang.String"/>
    <parameter name="fechaDesde" class="java.lang.String"/>
    <parameter name="fechaHasta" class="java.lang.String"/>
    <parameter name="fechaActual" class="java.lang.String"/>
    <parameter name="cuentaDesde" class="java.lang.String"/>
    <parameter name="totalDebe" class="java.lang.String"/>
    <parameter name="totalHaber" class="java.lang.String"/>
    <parameter name="cuenta" class="java.lang.String"/>

    <!-- ====================== CAMPOS ====================== -->
    <field name="fechaAsiento" class="java.lang.String"/>

    <field name="tipoAsiento" class="java.lang.String"/>
    <field name="numeroAsiento" class="java.lang.String"/>

    <field name="tipoDocumento" class="java.lang.String"/>
    <field name="numeroDocumento" class="java.lang.String"/>

    <field name="debe" class="java.lang.String"/>
    <field name="haber" class="java.lang.String"/>
    <field name="saldo" class="java.lang.String"/>
    <field name="concepto" class="java.lang.String"/>
    <field name="cuenta" class="java.lang.String"/>
    <field name="numeroIdentificacion" class="java.lang.String"/>
    <field name="tercero" class="java.lang.String"/>
    <field name="item" class="java.lang.String"/>
    <field name="codigoItem" class="java.lang.String"/>


    <!-- ====================== TITLE ====================== -->
    <title>
        <band height="100" splitType="Stretch">

            <textField>
                <reportElement x="0" y="0" width="500" height="20"/>
                <textElement>
                    <font isBold="true" size="15"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{empresa}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="20" width="500" height="20"/>
                <textElement>
                    <font size="13"/>
                </textElement>
                <textFieldExpression><![CDATA["Mayor General"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="40" width="500" height="20"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Sucursal: " + $P{sucursal}
                    + " / Desde: " + $P{fechaDesde}
                    + " Hasta: " + $P{fechaHasta}
                    + (
                        ($P{cuentaDesde} != null || $P{cuentaDesde} != null)
                        ? (
                            " / Cuenta "
                            + ($P{cuentaDesde} != null ? "Desde: " + $P{cuentaDesde} + " " : "")
                            + ($P{cuentaDesde} != null ? "Hasta: " + $P{cuentaDesde} : "")
                          )
                        : ""
                      )
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="390" y="15" width="150" height="20"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{fechaActual}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="65" width="555" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
        "Cuenta: " + $P{cuenta}
    ]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <!-- ====================== ENCABEZADOS ====================== -->
    <!-- ====================== ENCABEZADOS ====================== -->
    <columnHeader>
        <band height="28">

            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>

            <line>
                <reportElement x="0" y="3" width="555" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="6" width="60" height="20"/>
                <text><![CDATA[Fecha]]></text>
            </staticText>


            <staticText>
                <reportElement x="60" y="6" width="90" height="20"/>
                <text><![CDATA[Tp. Asiento]]></text>
            </staticText>


            <staticText>
                <reportElement x="135" y="6" width="120" height="20"/>
                <text><![CDATA[TD Número]]></text>
            </staticText>

            <staticText>
                <reportElement x="240" y="6" width="160" height="20"/>
                <text><![CDATA[Detalle/Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement x="400" y="6" width="50" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Debe]]></text>
            </staticText>

            <staticText>
                <reportElement x="450" y="6" width="50" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Haber]]></text>
            </staticText>

            <staticText>
                <reportElement x="500" y="6" width="55" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Saldo]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ====================== DETALLE ====================== -->
    <!-- ====================== DETALLE ====================== -->
    <detail>
        <band height="50">

            <!-- FECHA -->
            <textField>
                <reportElement x="0" y="0" width="60" height="20"/>
                <textFieldExpression><![CDATA[$F{fechaAsiento}]]></textFieldExpression>
            </textField>


            <!-- TP ASIENTO -->
            <textField>
                <reportElement x="60" y="0" width="90" height="20"/>

                <textFieldExpression><![CDATA[
        $F{tipoAsiento} + " " + $F{numeroAsiento}
    ]]></textFieldExpression>

            </textField>


            <!-- TD NUMERO -->
            <textField>
                <reportElement x="135" y="0" width="120" height="20"/>

                <textFieldExpression><![CDATA[
        $F{tipoDocumento} + " " + $F{numeroDocumento}
    ]]></textFieldExpression>

            </textField>


            <!-- DETALLE COMPLETO -->
            <textField isStretchWithOverflow="true">
                <reportElement x="250" y="0" width="160" height="40"/>

                <textElement>
                    <font size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[
    ($F{concepto} != null ? $F{concepto} : "")
    +
    ($F{tercero} != null ? "\n" + $F{tercero} : "")
    +
    ($F{numeroIdentificacion} != null ? " | " + $F{numeroIdentificacion} : "")
    +
    ($F{codigoItem} != null ? "\n" + $F{codigoItem} : "")
    +
    ($F{item} != null ? " - " + $F{item} : "")
]]></textFieldExpression>

            </textField>


            <!-- DEBE -->
            <textField>
                <reportElement x="400" y="0" width="50" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{debe}]]></textFieldExpression>
            </textField>


            <!-- HABER -->
            <textField>
                <reportElement x="450" y="0" width="50" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{haber}]]></textFieldExpression>
            </textField>


            <!-- SALDO -->
            <textField>
                <reportElement x="500" y="0" width="55" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{saldo}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ====================== TOTALES FINALES ====================== -->
    <summary>
        <band height="65">

            <line>
                <reportElement x="250" y="25" width="315" height="1"/>
            </line>

            <staticText>
                <reportElement x="250" y="25" width="90" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Totales:]]></text>
            </staticText>


            <textField pattern="#,##0.00">
                <reportElement x="420" y="25" width="70" height="15"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalDebe}]]></textFieldExpression>
            </textField>


            <textField pattern="#,##0.00">
                <reportElement x="465" y="25" width="70" height="15"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalHaber}]]></textFieldExpression>
            </textField>


            <line>
                <reportElement x="0" y="43" width="555" height="1"/>
            </line>

            <line>
                <reportElement x="0" y="47" width="555" height="1"/>
            </line>

        </band>
    </summary>

</jasperReport>
